# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API).
#
# Never commit your real .env file, and never put the service_role key here
# or anywhere in frontend code — only the anon/public key belongs in a
# browser-facing app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
